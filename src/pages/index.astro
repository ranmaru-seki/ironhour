---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Facts from '../components/Facts.astro';
import Problem from '../components/Problem.astro';
import Reason from '../components/Reason.astro';
import Flow from '../components/Flow.astro';
import Voice from '../components/Voice.astro';
import Price from '../components/Price.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="IRONHOUR｜30代のための8週間パーソナルトレーニング"
  description="仕事が忙しい30代のための、短期集中パーソナルトレーニング。週2回・60分×8週間で、続く仕組みをつくる。（ポートフォリオ用の架空サイト）"
>
  <Header />
  <main>
    <Hero />
    <Facts />
    <Problem />
    <Reason />
    <Flow />
    <Voice />
    <Price />
    <Faq />
    <Cta />
  </main>
  <Footer />
</BaseLayout>
